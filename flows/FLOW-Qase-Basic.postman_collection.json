{
  "info": {
    "name": "FLOW - Qase Basic",
    "description": "Read-only smoke flow bound to Qase cases QAPI-001..004. One request per Qase case; newman's JUnit testsuite name (\"Qase Basic / <request>\") is the binding key in automation-map.json. Creates nothing, so it is safe to re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Qase Basic",
      "item": [
        {
          "name": "00 Setup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('_flow_failed');",
                  "pm.collectionVariables.unset('_flow_failed_at');",
                  "pm.collectionVariables.unset('basicAccessToken');",
                  "pm.collectionVariables.set('_skip_url', pm.environment.get('security_base_url') + '/actuator/health');",
                  "console.log('Qase Basic: state cleared for env=' + pm.environment.get('env_name'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('00 security service reachable', () => { if (code !== 200) { pm.collectionVariables.set('_flow_failed','true');pm.collectionVariables.set('_flow_failed_at','00 Setup'); } pm.expect(code).to.eql(200); });",
                  "pm.test('00 health reports UP', () => { let b={}; try{b=pm.response.json();}catch(e){} pm.expect(String(b.status||'')).to.match(/UP/i); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{security_base_url}}/actuator/health",
              "host": [
                "{{security_base_url}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "01 Admin Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  console.log('SKIP: ' + pm.info.requestName + ' (previous step failed)');",
                  "  pm.request.url = pm.collectionVariables.get('_skip_url') || 'http://localhost:1/__skip__';",
                  "  return;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  pm.test('SKIPPED: ' + pm.info.requestName + ' (failed at: ' + (pm.collectionVariables.get('_flow_failed_at')||'?') + ')', function() {});",
                  "  return;",
                  "}",
                  "const code = pm.response.code;",
                  "pm.test('01 admin login 2xx', () => { if(![200,201].includes(code)){ pm.collectionVariables.set('_flow_failed','true');pm.collectionVariables.set('_flow_failed_at','01 Admin Login'); } pm.expect(code).to.be.oneOf([200,201]); });",
                  "let b={}; try{b=pm.response.json();}catch(e){}",
                  "pm.test('01 has access_token', () => pm.expect(b.access_token).to.not.be.undefined);",
                  "pm.test('01 has refresh_token', () => pm.expect(b.refresh_token).to.not.be.undefined);",
                  "pm.test('01 has expires_in', () => pm.expect(b.expires_in).to.be.a('number'));",
                  "if (b.access_token) pm.collectionVariables.set('basicAccessToken', b.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-TENANT-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{security_base_url}}/admin/login",
              "host": [
                "{{security_base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "02 Validate Tenant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  console.log('SKIP: ' + pm.info.requestName + ' (previous step failed)');",
                  "  pm.request.url = pm.collectionVariables.get('_skip_url') || 'http://localhost:1/__skip__';",
                  "  return;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  pm.test('SKIPPED: ' + pm.info.requestName + ' (failed at: ' + (pm.collectionVariables.get('_flow_failed_at')||'?') + ')', function() {});",
                  "  return;",
                  "}",
                  "const code = pm.response.code;",
                  "pm.test('02 valid tenant accepted', () => { if(code !== 200){ pm.collectionVariables.set('_flow_failed','true');pm.collectionVariables.set('_flow_failed_at','02 Validate Tenant'); } pm.expect(code).to.eql(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-TENANT-ID",
                "value": "{{tenant_id}}"
              }
            ],
            "url": {
              "raw": "{{security_base_url}}/admin/validate-tenant",
              "host": [
                "{{security_base_url}}"
              ],
              "path": [
                "admin",
                "validate-tenant"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "03 List Schemas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  console.log('SKIP: ' + pm.info.requestName + ' (previous step failed)');",
                  "  pm.request.url = pm.collectionVariables.get('_skip_url') || 'http://localhost:1/__skip__';",
                  "  return;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('_flow_failed') === 'true') {",
                  "  pm.test('SKIPPED: ' + pm.info.requestName + ' (failed at: ' + (pm.collectionVariables.get('_flow_failed_at')||'?') + ')', function() {});",
                  "  return;",
                  "}",
                  "const code = pm.response.code;",
                  "pm.test('03 schema list 200', () => { if(code !== 200){ pm.collectionVariables.set('_flow_failed','true');pm.collectionVariables.set('_flow_failed_at','03 List Schemas'); } pm.expect(code).to.eql(200); });",
                  "let b=null; try{b=pm.response.json();}catch(e){}",
                  "pm.test('03 response is a list', () => pm.expect(Array.isArray(b) || Array.isArray((b||{}).content) || Array.isArray((b||{}).data)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-TENANT-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{basicAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{app_base_url}}/schema",
              "host": [
                "{{app_base_url}}"
              ],
              "path": [
                "schema"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "basicAccessToken",
      "value": ""
    },
    {
      "key": "_flow_failed",
      "value": ""
    },
    {
      "key": "_flow_failed_at",
      "value": ""
    },
    {
      "key": "_skip_url",
      "value": ""
    }
  ]
}