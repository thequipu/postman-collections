          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{tenant_base_url}}/admin/actuator/health",
              "host": [
                "{{tenant_base_url}}"
              ],
              "path": [
                "admin",
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Tenant Service health via http://167.86.123.100:4031/admin/actuator/health."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tenant Service · HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('responds under threshold', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "try { const j=pm.response.json(); const st=String(j.status||j.state||'').toUpperCase();",
                  "  pm.test('Tenant Service · status healthy', () => pm.expect(st).to.match(/UP|OK|HEALTHY|SERVING/)); } catch(e){}"
                ]
              }
            }
          ],
          "response": []
