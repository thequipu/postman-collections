  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ===== Prod safety guard: block destructive verbs when allow_destructive=false =====",
          "const destructive = ['POST','PUT','PATCH','DELETE'];",
          "const url = pm.request.url.toString();",
          "if (pm.environment.get('allow_destructive') === 'false'",
          "    && destructive.includes(pm.request.method)",
          "    && !url.includes('/token')) {",
          "    throw new Error(`Blocked ${pm.request.method} in env=${pm.environment.get('env_name')} (allow_destructive=false)`);",
          "}",
          "",
          "// ===== Centralized Keycloak auth with token caching (60s safety margin) =====",
          "const tokenUrl = pm.environment.get('keycloak_token_url');",
          "const user = pm.environment.get('test_username');",
          "if (!tokenUrl || !user) { return; }   // health checks are public; skip auth if creds not provided",
          "const token  = pm.collectionVariables.get('access_token');",
          "const expiry = pm.collectionVariables.get('token_expiry');",
          "if (token && expiry && Date.now() < Number(expiry) - 60000) { return; }",
          "pm.sendRequest({",
          "    url: tokenUrl,",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "    body: { mode: 'urlencoded', urlencoded: [",
          "        { key: 'grant_type',    value: 'password' },",
          "        { key: 'client_id',     value: pm.environment.get('client_id') },",
          "        { key: 'client_secret', value: pm.environment.get('client_secret') },",
          "        { key: 'username',      value: pm.environment.get('test_username') },",
          "        { key: 'password',      value: pm.environment.get('test_password') }",
          "    ] }",
          "}, (err, res) => {",
          "    if (err || res.code !== 200) {",
          "        throw new Error(`Keycloak token fetch failed for env=${pm.environment.get('env_name')}: ${err || res.status}`);",
          "    }",
          "    const b = res.json();",
          "    pm.collectionVariables.set('access_token', b.access_token);",
          "    pm.collectionVariables.set('token_expiry', Date.now() + b.expires_in * 1000);",
          "    pm.environment.set('access_token', b.access_token);",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level baseline applied after every request",
          "pm.test('no server error (5xx)', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_expiry",
      "value": "",
      "type": "string"
    }
  ],
