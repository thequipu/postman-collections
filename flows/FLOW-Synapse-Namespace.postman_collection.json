              "query": [
                {
                  "key": "permanent",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('99 teardown tolerant', () => pm.expect(pm.response.code).to.be.oneOf([200,204,400,404]));",
                  "pm.collectionVariables.unset('_flow_failed');",
                  "pm.collectionVariables.unset('_flow_failed_at');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
