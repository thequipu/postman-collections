    {
      "name": "RAG Chat (WebSocket)",
      "item": [
        {
          "name": "README - add manually",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rag/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rag",
                "chat"
              ]
            },
            "description": "This is a WebSocket endpoint (ws://.../rag/chat), not plain HTTP. Postman's collection v2.1 export format doesn't reliably round-trip WebSocket requests, so create it manually: New -> WebSocket Request -> ws://localhost:3038/rag/chat.\n\nProtocol once connected:\n1. Send: {\"realm\": \"<realm>\", \"fullQuery\": \"<query>\"}\n2. Server replies: {\"message\": \"AI is ready, you can start conversation\"}\n3. Send: {\"message\": \"<your question>\"}\n4. Send {\"message\": \"exit\"} to close the session."
          },
          "response": []
        }
      ]
    }
