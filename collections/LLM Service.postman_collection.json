    {
      "name": "Query Builder",
      "item": [
        {
          "name": "Search Vector Query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-TENANT-ID",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/query-builder/query?realm={{realm}}&question=What is the total revenue this month?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query-builder",
                "query"
              ],
              "query": [
                {
                  "key": "realm",
                  "value": "{{realm}}"
                },
                {
                  "key": "question",
                  "value": "What is the total revenue this month?"
                }
              ]
            },
            "description": "realm and question are query params (not a JSON body). Authorization header is also read explicitly by this endpoint in addition to the middleware."
          },
          "response": []
        },
        {
          "name": "Reset Schema",
          "request": {
            "method": "GET",
