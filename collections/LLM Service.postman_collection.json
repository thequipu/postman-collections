{
  "info": {
    "_postman_id": "9282995c-bb0f-452b-b2ec-7b73e889e7b4",
    "name": "LLM Service",
    "description": "FastAPI-based LLM service: RAG Q&A, entity360 suggestions, pre-processing suggestions, query builder, health check, and RAG chat websocket.\n\nAll endpoints except /actuator/health require:\n- Authorization: Bearer <JWT>\n- X-TENANT-ID: <tenant id>\n\nboth are validated by a global middleware (verify_token) against the tenant's RSA public key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56383100",
    "_collection_link": "https://go.postman.co/collection/56383100-9282995c-bb0f-452b-b2ec-7b73e889e7b4?source=collection_link"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Not gated by the auth middleware - no headers required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Context Question Answer",
      "item": [
        {
          "name": "Get Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-TENANT-ID",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What is the capital of France?\" },\n    { \"role\": \"assistant\", \"content\": \"The capital of France is Paris.\" },\n    { \"role\": \"user\", \"content\": \"What is its population?\" }\n  ],\n  \"model\": \"gpt-4o\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/context-question-answer/getAnswer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "context-question-answer",
                "getAnswer"
              ]
            },
            "description": "Requires at least 2 messages in the `messages` array (400 otherwise)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Entity360 Builder",
      "item": [
        {
          "name": "Get Entity360 Suggestions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-TENANT-ID",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nodes\": [\n    { \"id\": \"Person\", \"label\": \"Person\", \"properties\": [\"name\", \"email\"] },\n    { \"id\": \"Company\", \"label\": \"Company\", \"properties\": [\"name\", \"domain\"] }\n  ],\n  \"links\": [\n    { \"source\": \"Person\", \"target\": \"Company\", \"relation\": \"WORKS_AT\" }\n  ],\n  \"prefix\": \"quipu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/entity360-builder/get-entity360s",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "entity360-builder",
                "get-entity360s"
              ]
            }
          },
          "response": []
        }
      ]
    },
