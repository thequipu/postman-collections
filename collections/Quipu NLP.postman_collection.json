{
  "info": {
    "_postman_id": "20bae79b-79a9-4a8a-9053-3b2089e83061",
    "name": "Quipu NLP",
    "description": "Stateless FastAPI sidecar used by quipu-nexus for tokenizing TextItem content, merging nexus-supplied per-token URI matches into final spans, sentence splitting, and text embeddings via sentence-transformers.\n\nNo auth middleware - this is an internal sidecar service, not internet facing. Wire-format models are the contract with nexus's `NlpClient`; field names must stay in sync.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56383100",
    "_collection_link": "https://go.postman.co/collection/56383100-20bae79b-79a9-4a8a-9053-3b2089e83061?source=collection_link"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns status plus the loaded spaCy model and sentence-transformers embedding model names."
