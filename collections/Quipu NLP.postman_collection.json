              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/embed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "embed"
              ]
            },
            "description": "Returns one embedding vector per input text using sentence-transformers/all-mpnet-base-v2 (default, overridable via SENTENCE_TRANSFORMERS_MODEL env var). Empty texts array returns an empty embeddings array."
          },
          "response": []
        }
      ]
    }
