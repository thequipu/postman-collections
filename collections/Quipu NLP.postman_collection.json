              "raw": "{\n  \"text\": \"Acme Corp signed contract INV-2024-0091 with Globex on March 3rd.\",\n  \"lang\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tokenize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tokenize"
              ]
            },
            "description": "Returns significant tokens only (PROPN/NOUN/NUM/X/SYM POS tags, or identifier-like strings) with lemma and char offsets. No NER labels are returned."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sentenize",
      "item": [
        {
          "name": "Split Into Sentences",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Acme Corp signed a new contract with Globex. The deal closes on March 3rd.\",\n  \"lang\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sentenize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sentenize"
              ]
            },
            "description": "Rule-based sentence splitting. Returns each sentence with start/end char offsets into the original text."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Finalize Spans",
      "item": [
        {
          "name": "Merge Tokens By URI Agreement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Acme Corp signed contract INV-2024-0091 with Globex.\",\n  \"tokens\": [\n    { \"text\": \"Acme\", \"start\": 0, \"end\": 4, \"uris\": [\"urn:org:acme\"] },\n    { \"text\": \"Corp\", \"start\": 5, \"end\": 9, \"uris\": [\"urn:org:acme\"] },\n    { \"text\": \"INV-2024-0091\", \"start\": 18, \"end\": 31, \"uris\": [\"urn:invoice:inv-2024-0091\"] },\n    { \"text\": \"Globex\", \"start\": 37, \"end\": 43, \"uris\": [\"urn:org:globex\"] }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/finalize-spans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "finalize-spans"
              ]
            },
            "description": "Input is the per-token candidate-URI matrix nexus builds after running GIN+vector searches on each token from /tokenize. Adjacent tokens that agree on a URI get merged into one span."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Embed",
      "item": [
        {
