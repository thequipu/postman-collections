            "body": {
              "mode": "raw",
              "raw": "{\n  \"fabricId\": \"production-fabric\",\n  \"query\": \"customers who ordered from Acme Corp last quarter\",\n  \"topK\": 15,\n  \"skipUnstructured\": false\n}",
