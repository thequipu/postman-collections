            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataSource\": {\n    \"id\": 5,\n    \"driverType\": \"POSTGRES\",\n    \"dbHostName\": \"localhost\",\n    \"dbPort\": 5432,\n    \"databaseName\": \"mydb\"\n  },\n  \"metadataTables\": [\n    {\n      \"name\": { \"name\": \"customers\", \"dataCatalogName\": \"customers\", \"ontologyName\": \"Customer\" },\n      \"type\": \"TABLE\",\n      \"namedEntity\": true,\n      \"erEntity\": true,\n      \"selected\": true,\n      \"datasourceName\": \"postgres-prod\",\n      \"properties\": [\n        {\n          \"name\": { \"name\": \"id\", \"dataCatalogName\": \"id\" },\n          \"type\": \"BIGINT\",\n          \"nullable\": false,\n          \"primaryKey\": true,\n          \"uniqueKey\": false,\n          \"datasourceName\": \"postgres-prod\"\n        }\n      ],\n      \"dataSetRelationShips\": []\n    }\n  ],\n  \"shape\": {\n    \"shape\": {},\n    \"constraints\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
