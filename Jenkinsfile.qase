// Qase-triggered automation run — Jenkins pipeline
// Started FROM Qase (Test Runs -> Launch), which passes the run it just created as
// build parameters. The job runs a test script, converts its output into Qase results,
// posts them against that run, and optionally completes it.
//
// One-time setup:
//   1. Jenkins: store the Qase API token as a Secret text credential, id `qase-api-token`
//   2. Qase:    Apps -> Jenkins, point it at this job with a Jenkins API token
//   3. Qase:    the job must be parameterized with the five QASE_* parameters below
//
// The script is expected to leave `reports/results.json` behind:
//   [{"id": "TC_LOGIN01", "status": "passed", "ms": 240},
//    {"id": "TC_LOGIN02", "status": "failed", "ms": 900, "error": "expected 400, got 500"}]
// `id` is the external id; qase-case-map.json turns it into a Qase case id.

pipeline {
  // This Jenkins has no Docker Pipeline plugin, so the agent runs the script
  // directly. It needs python3 and curl on PATH.
  agent any

  parameters {
    // --- passed in by Qase when it launches the run ---
    string(name: 'QASE_PROJECT_CODE', defaultValue: '',  description: 'Qase project code, e.g. AM')
    string(name: 'QASE_RUN_ID',       defaultValue: '',  description: 'Qase run id to report against')
    booleanParam(name: 'QASE_REPORT',        defaultValue: true,  description: 'Publish results to Qase')
    booleanParam(name: 'QASE_RUN_COMPLETE',  defaultValue: true,  description: 'Complete the Qase run afterwards')
    string(name: 'QASE_API_BASE_URL', defaultValue: 'https://api.qase.io', description: 'Qase API base URL')

    // --- ours ---
    choice(name: 'ENVIRONMENT', choices: ['onprem', 'prestage', 'local'],
           description: 'Target environment')
    string(name: 'SCRIPT', defaultValue: 'scripts/run_suite.sh',
           description: 'Test script to run, relative to the repo root')
    choice(name: 'MODE', choices: ['real', 'smoke', 'simulate'],
           description: 'real = run the automation each case is bound to; smoke = one reachability probe; simulate = deterministic sample results')
    string(name: 'UI_REPO_URL', defaultValue: 'https://github.com/thequipu/automation_fast_api.git',
           description: 'Playwright repo, checked out only when the run holds pytest-bound cases')
    string(name: 'UI_REPO_BRANCH', defaultValue: 'main', description: 'Branch of the Playwright repo')
    string(name: 'SEED', defaultValue: '1',
           description: 'Seed for simulate mode; the same seed reproduces the same results')
    string(name: 'BUILD_ENDPOINT', defaultValue: '',
           description: 'Service endpoint returning the build/version. Read when the run starts and stamped on the Qase run.')
    booleanParam(name: 'FAIL_ON_TEST_FAILURE', defaultValue: true,
           description: 'Fail the build when any case fails. Uncheck to report-only.')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    QASE_API_TOKEN = credentials('qase-api-token')
    RESULTS        = 'reports/results.json'
    CASE_MAP       = 'qase-case-map.json'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Prepare runners') {
      when { expression { params.MODE == 'real' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -uo pipefail
          command -v newman >/dev/null || npm install -g newman || \
            echo "!! newman install failed - newman-bound cases will report blocked"
          newman --version 2>/dev/null || true
        '''
        // Only clone the UI repo when a pytest-bound case is actually in scope.
        sh '''#!/usr/bin/env bash
          set -uo pipefail
          python3 - <<'EOF' || exit 0
import json, sys
m = json.load(open("automation-map.json"))
sys.exit(0 if any(v.get("runner") == "pytest" for v in m.values()) else 1)
EOF
          if [ ! -d ui-repo ]; then
            git clone --depth 1 -b "${UI_REPO_BRANCH}" "${UI_REPO_URL}" ui-repo || {
              echo "!! could not clone the UI repo - pytest cases will report blocked"; exit 0; }
          fi
          cd ui-repo && python3 -m pip install -q -r requirements.txt \
            && python3 -m playwright install --with-deps chromium \
            || echo "!! playwright setup failed - pytest cases will report blocked"
        '''
      }
    }

    stage('Run tests') {
      steps {
        sh '''#!/usr/bin/env bash
          set -uo pipefail          # not -e: let every case run, gate on results instead
          mkdir -p reports
          rm -f "${RESULTS}"        # never publish a previous build's results
          echo ">> environment: ${ENVIRONMENT}"
          echo ">> script:      ${SCRIPT}   (mode=${MODE:-smoke} seed=${SEED:-1})"
          MODE="${MODE:-smoke}" SEED="${SEED:-1}" BUILD_ENDPOINT="${BUILD_ENDPOINT:-}" \
          ENVIRONMENT="${ENVIRONMENT}" UI_REPO="${WORKSPACE}/ui-repo" \
            bash "${SCRIPT}" \
            || echo ">> script exited non-zero — results still published"
          test -f "${RESULTS}" || { echo "!! ${RESULTS} not produced"; exit 1; }
          echo ">> $(python3 -c "import json;print(len(json.load(open('${RESULTS}'))))") results"
        '''
      }
    }

    stage('Publish to Qase') {
      when {
        allOf {
          expression { params.QASE_REPORT }
          expression { params.QASE_RUN_ID?.trim() }
        }
      }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          python3 - <<'PY'
import json, os, urllib.request

base  = os.environ["QASE_API_BASE_URL"].rstrip("/")
code  = os.environ["QASE_PROJECT_CODE"]
run   = os.environ["QASE_RUN_ID"]
token = os.environ["QASE_API_TOKEN"]

results  = json.load(open(os.environ["RESULTS"]))
case_map = json.load(open(os.environ["CASE_MAP"]))      # external id -> qase case id

# Only report cases the run actually contains. Without this, a run scoped to one
# suite silently grows to hold every case in the map.
def _get(path):
    rq = urllib.request.Request(f"{base}{path}", headers={"Token": token, "accept": "application/json"})
    with urllib.request.urlopen(rq, timeout=60) as r:
        return json.loads(r.read())
try:
    in_run = set(_get(f"/v1/run/{code}/{run}?include=cases")["result"]["cases"])
    print(f">> run {run} holds {len(in_run)} cases")
except Exception as e:
    in_run = None
    print(f"!! could not read the run's case list ({e}) - reporting everything")

# our vocabulary -> Qase's
STATUS = {"passed": "passed", "pass": "passed",
          "failed": "failed", "fail": "failed",
          "skipped": "skipped", "skip": "skipped",
          "blocked": "blocked", "error": "failed"}

payload, unmapped = [], []
for r in results:
    cid = case_map.get(r["id"])
    if not cid:
        unmapped.append(r["id"]); continue
    if in_run is not None and cid not in in_run:
        continue                                   # not part of this run
    entry = {"case_id": cid,
             "status": STATUS.get(str(r.get("status", "")).lower(), "skipped")}
    if r.get("ms"):    entry["time_ms"] = int(r["ms"])
    c = r.get("error") or r.get("reason")   # a skip reason is worth reading in Qase too
    if c: entry["comment"] = str(c)[:5000]
    payload.append(entry)

if unmapped:
    print(f"!! {len(unmapped)} results had no Qase case: {unmapped[:10]}")

req = urllib.request.Request(
    f"{base}/v1/result/{code}/{run}/bulk",
    data=json.dumps({"results": payload}).encode(),
    headers={"Token": token, "Content-Type": "application/json"},
    method="POST")
with urllib.request.urlopen(req, timeout=120) as resp:
    print(f">> published {len(payload)} results for run {run}: HTTP {resp.status}")
PY
        '''
      }
    }

    stage('Stamp build on the run') {
      when {
        allOf {
          expression { params.QASE_RUN_ID?.trim() }
          expression { fileExists('reports/build.txt') }
        }
      }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          BUILD=$(cat reports/build.txt)
          if [ "$BUILD" = "unknown" ] || [ -z "$BUILD" ]; then
            echo ">> no build reported by the service - leaving the run's Build field alone"
            exit 0
          fi
          curl -sS -X PATCH -H "Token: ${QASE_API_TOKEN}" -H "Content-Type: application/json" \
            "${QASE_API_BASE_URL%/}/v1/run/${QASE_PROJECT_CODE}/${QASE_RUN_ID}" \
            -d "{\"custom_field\":{\"3\":\"${BUILD}\"}}" >/dev/null || true
          echo ">> stamped run ${QASE_RUN_ID} with build ${BUILD}"
        '''
      }
    }

    stage('Complete run') {
      when {
        allOf {
          expression { params.QASE_RUN_COMPLETE }
          expression { params.QASE_RUN_ID?.trim() }
        }
      }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          curl -sS -X POST \
            -H "Token: ${QASE_API_TOKEN}" -H "Content-Type: application/json" \
            "${QASE_API_BASE_URL%/}/v1/run/${QASE_PROJECT_CODE}/${QASE_RUN_ID}/complete"
          echo ""
        '''
      }
    }

    stage('Build dashboard') {
      steps {
        // Last stage, so it picks up the results this build just published.
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          python3 tools/build-dashboard.py -o reports/dashboard.html
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      junit testResults: 'reports/junit/*.xml', allowEmptyResults: true
      // Jenkins' default CSP strips inline CSS/JS from published HTML, so this
      // tab may render bare. Download the archived dashboard.html to view it.
      publishHTML(target: [reportDir: 'reports', reportFiles: 'dashboard.html',
                           reportName: 'QQA Run Console', keepAll: true,
                           allowMissing: true, alwaysLinkToLastBuild: true])
    }
    success {
      script {
        if (params.FAIL_ON_TEST_FAILURE) {
          def failed = sh(returnStdout: true, script: '''
            python3 -c "import json;print(sum(1 for r in json.load(open('reports/results.json')) if str(r.get('status','')).lower() in ('failed','fail','error')))"
          ''').trim()
          if (failed != '0') {
            error("${failed} case(s) failed — see the Qase run for detail")
          }
        }
      }
    }
  }
}
