# Test run output
reports/
results/
newman/

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Secrets — never commit real credential values
config/secrets/
*.secrets.env
*.local.json
# S3 datasource configs carry a RAW AWS secret — keep in S3, sync down at test time
config/db-configs/csv-datatype.json
config/db-configs/excel-datatype.json
# temp globals built by scripts/run_realm_full.py
realm_globals_*.json

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
config/db-configs/csv-users.json

# Neuro test scripts — these embed credentials in plaintext (USERNAME, PASSWORD,
# CLIENT_SECRET). Ignoring them stops NEW copies being added; the ones already
# tracked are unaffected until removed from the index with `git rm --cached`.
scripts/neuro_*.sh
tools/neuro-sim/config/*.yaml
docker/requirements.txt
